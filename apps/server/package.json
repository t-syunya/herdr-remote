{
  "name": "@herdr/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @herdr/herdr build && tsx watch src/index.ts",
    "lint": "eslint src",
    "test": "pnpm --filter @herdr/herdr build && tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@herdr/herdr": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6"
  }
}
